{
  "name": "@kong/spec-renderer",
  "version": "1.111.2",
  "description": "Kong's open-source spec renderer",
  "license": "Apache-2.0",
  "type": "module",
  "main": "./dist/kong-spec-renderer.cjs",
  "module": "./dist/kong-spec-renderer.es.js",
  "files": [
    "dist"
  ],
  "types": "dist/types/index.d.ts",
  "typings": "dist/types",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/kong-spec-renderer.es.js",
      "require": "./dist/kong-spec-renderer.cjs"
    },
    "./web-component": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/kong-spec-renderer.web-component.es.js",
      "require": "./dist/kong-spec-renderer.web-component.cjs"
    },
    "./dist/style.css": "./dist/spec-renderer.css",
    "./package.json": "./package.json",
    "./dist/*": "./dist/*"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "dev": "cross-env USE_SANDBOX=true vite",
    "build": "pnpm run typecheck && pnpm run build:package && pnpm run build:webcomponent && pnpm run build:types && pnpm run build:aliases",
    "build:package": "vite build -m production",
    "build:webcomponent": "cross-env VITE_AS_WEB_COMPONENT='true' vite build -m production",
    "build:types": "vue-tsc -p './tsconfig.build.json' --emitDeclarationOnly",
    "build:aliases": "tsc-alias -p './tsconfig.build.json'",
    "build:analyzer": "BUILD_VISUALIZER='true' vite build -m production",
    "build:sandbox": "cross-env USE_SANDBOX=true vite build -m production",
    "preview": "pnpm run build:sandbox && cross-env USE_SANDBOX=true vite preview",
    "typecheck": "vue-tsc -p './tsconfig.build.json' --noEmit",
    "stylelint": "stylelint --allow-empty-input './src/**/*.{css,scss,vue}'",
    "stylelint:fix": "stylelint --allow-empty-input './src/**/*.{css,scss,sass,vue}' --fix",
    "lint": "eslint",
    "lint:fix": "eslint --fix",
    "test": "cross-env FORCE_COLOR=1 vitest run",
    "test:open": "cross-env FORCE_COLOR=1 vitest --ui",
    "semantic-release": "semantic-release",
    "commit": "cz"
  },
  "peerDependencies": {
    "vue": ">= 3.3.13 < 4"
  },
  "dependencies": {
    "@apidevtools/json-schema-ref-parser": "14.0.3",
    "@asyncapi/avro-schema-parser": "^3.0.24",
    "@asyncapi/openapi-schema-parser": "^3.0.24",
    "@asyncapi/parser": "^3.6.0",
    "@floating-ui/vue": "^1.1.11",
    "@kong/icons": "^1.61.2",
    "@stoplight/http-spec": "^7.1.0",
    "@stoplight/json": "^3.21.7",
    "@stoplight/types": "^14.1.1",
    "@stoplight/yaml": "^4.3.0",
    "@vueuse/core": "^14.3.0",
    "allof-merge": "^0.6.8",
    "flatted": "^3.4.2",
    "form-urlencoded": "^6.1.7",
    "httpsnippet": "^3.0.10",
    "lodash-es": "^4.18.1",
    "markdown-it": "^14.3.0",
    "sanitize-html": "^2.17.6",
    "shiki": "^3.23.0"
  },
  "resolutions": {
    "openapi3-ts": "4.6.0"
  },
  "devDependencies": {
    "@babel/types": "^8.0.4",
    "@commitlint/cli": "^19.8.1",
    "@commitlint/config-conventional": "^19.8.1",
    "@digitalroute/cz-conventional-changelog-for-jira": "^8.0.1",
    "@evilmartians/lefthook": "^2.1.10",
    "@kong/design-tokens": "2.0.1",
    "@kong/eslint-config-kong-ui": "1.7.1",
    "@kong/stylelint-plugin-design-tokens": "1.0.1",
    "@semantic-release/changelog": "^6.0.3",
    "@semantic-release/git": "^10.0.1",
    "@stylistic/stylelint-plugin": "^5.2.1",
    "@types/jsdom": "^28.0.3",
    "@types/json-schema": "^7.0.15",
    "@types/markdown-it": "^14.1.2",
    "@types/node": "^24.13.3",
    "@types/sanitize-html": "^2.16.1",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vitest/ui": "^3.2.7",
    "@vue/test-utils": "^2.4.11",
    "@vue/tsconfig": "^0.9.1",
    "autoprefixer": "^10.5.3",
    "c8": "^11.0.0",
    "commitizen": "^4.3.2",
    "cross-env": "^10.1.0",
    "cz-conventional-changelog": "^3.3.0",
    "eslint": "^10.5.0",
    "jsdom": "^29.1.1",
    "openapi3-ts": "4.6.0",
    "postcss": "^8.5.23",
    "postcss-html": "^1.8.1",
    "rimraf": "^6.1.3",
    "rollup-plugin-visualizer": "^6.0.11",
    "sass": "^1.101.0",
    "sass-embedded": "^1.100.0",
    "semantic-release": "^25.0.7",
    "stylelint": "^17.14.0",
    "stylelint-config-html": "^1.1.0",
    "stylelint-config-recommended-scss": "^17.0.1",
    "stylelint-config-recommended-vue": "^1.6.1",
    "stylelint-order": "^8.1.1",
    "ts-node": "^10.9.2",
    "tsc-alias": "^1.8.17",
    "tslib": "^2.8.1",
    "typescript": "^5.9.3",
    "vite": "^7.3.6",
    "vite-plugin-node-polyfills": "^0.28.0",
    "vite-plugin-replace": "^0.1.1",
    "vite-plugin-vue-devtools": "^8.1.5",
    "vitest": "4.1.10",
    "vue": "^3.5.39",
    "vue-router": "^4.6.4",
    "vue-tsc": "^3.3.7"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@evilmartians/lefthook",
      "@parcel/watcher",
      "esbuild",
      "vue-demi"
    ],
    "overrides": {
      "openapi3-ts": "4.6.0",
      "jsonpath-plus@<10.3.0": ">=10.4.0",
      "elliptic@<=6.6.0": ">=6.6.1",
      "@babel/helpers@<8.0.0": ">=8.0.0",
      "cross-spawn@>=7.0.0 <7.0.5": ">=7.0.6",
      "brace-expansion@<=5.0.7": ">=5.0.9",
      "pbkdf2@<=3.1.2": ">=3.1.6",
      "sha.js@<=2.4.11": ">=2.4.12",
      "cipher-base@<=1.0.4": ">=1.0.7",
      "glob@>=10.2.0 <10.5.0": ">=13.0.6",
      "diff@>=4.0.0 <4.0.4": ">=4.0.4",
      "@isaacs/brace-expansion@<=5.0.0": ">=5.0.1",
      "mdast-util-to-hast@>=13.0.0 <13.2.1": ">=13.2.1",
      "qs@>=6.7.0 <=6.15.1": ">=6.15.3",
      "bn.js@>=5.0.0 <5.2.3": ">=5.2.5",
      "bn.js@<4.12.3": ">=5.2.5",
      "rollup@>=4.0.0 <4.59.0": ">=4.62.2",
      "minimatch@<10.2.3": ">=10.2.5",
      "ajv@<6.14.0": "^6.15.0",
      "immutable@>=5.0.0 <5.1.8": ">=5.1.9",
      "flatted@<=3.4.1": ">=3.4.2",
      "undici@<6.24.0": ">=8.5.0",
      "undici@>=7.0.0 <7.29.0": "7.29.0",
      "undici@>=8.0.0 <8.9.0": ">=8.9.0",
      "handlebars@>=4.0.0 <4.7.9": ">=4.7.9",
      "picomatch@<2.3.2": ">=4.0.5",
      "lodash-es@<=4.17.23": ">=4.18.0",
      "lodash@<=4.17.23": ">=4.18.0",
      "yaml@>=2.0.0 <2.8.3": ">=2.9.0",
      "fast-uri@<=3.1.1": ">=3.1.4",
      "fast-uri@>=4.0.0 <4.1.2": ">=4.1.2",
      "uuid@<11.1.1": ">=11.1.1",
      "vitest@<3.2.6": ">=3.2.7",
      "js-cookie@<=3.0.5": ">=3.0.8",
      "tmp@<0.2.6": ">=0.2.7",
      "esbuild@>=0.27.3 <0.28.1": ">=0.28.1",
      "sanitize-html@=2.17.3": ">=2.17.6",
      "ws@>=8.0.0 <8.21.0": ">=8.21.1",
      "form-data@>=4.0.0 <4.0.6": ">=4.0.6",
      "vite@>=7.0.0 <=7.3.4": ">=7.3.6",
      "@babel/core@<8.0.0": ">=8.0.1",
      "markdown-it@<=14.1.1": ">=14.2.0",
      "linkify-it@<=5.0.0": ">=5.0.2",
      "js-yaml@>=4.0.0 <=4.1.1": ">=4.3.0",
      "js-yaml@>=5.0.0 <=5.2.1": ">=5.2.2"
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Kong/spec-renderer.git"
  },
  "homepage": "https://github.com/Kong/spec-renderer",
  "bugs": {
    "url": "https://github.com/Kong/spec-renderer/issues"
  },
  "author": {
    "name": "Kong Inc.",
    "url": "https://konghq.com/"
  },
  "release": {
    "branches": [
      "+([0-9])?(.{+([0-9]),x}).x",
      "main",
      "next",
      "next-major",
      {
        "name": "beta",
        "prerelease": true
      },
      {
        "name": "alpha",
        "prerelease": true
      }
    ],
    "plugins": [
      "@semantic-release/commit-analyzer",
      "@semantic-release/release-notes-generator",
      [
        "@semantic-release/changelog",
        {
          "changelogFile": "CHANGELOG.md"
        }
      ],
      "@semantic-release/npm",
      [
        "@semantic-release/git",
        {
          "assets": [
            "CHANGELOG.md",
            "package.json"
          ]
        }
      ],
      "@semantic-release/github"
    ]
  },
  "engines": {
    "node": ">=18.17.0"
  },
  "volta": {
    "node": "24.18.0",
    "pnpm": "10.33.4"
  },
  "config": {
    "commitizen": {
      "path": "./node_modules/@digitalroute/cz-conventional-changelog-for-jira",
      "skipScope": false,
      "jiraOptional": true,
      "jiraLocation": "post-description",
      "jiraPrepend": "[",
      "jiraAppend": "]"
    }
  },
  "packageManager": "pnpm@10.33.4"
}
