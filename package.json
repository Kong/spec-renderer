{
  "name": "@kong/spec-renderer",
  "version": "1.107.13",
  "description": "Kong's open-source spec renderer",
  "license": "Apache-2.0",
  "type": "module",
  "main": "./dist/kong-spec-renderer.cjs",
  "module": "./dist/kong-spec-renderer.es.js",
  "files": [
    "dist"
  ],
  "types": "dist/types/index.d.ts",
  "typings": "dist/types",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/kong-spec-renderer.es.js",
      "require": "./dist/kong-spec-renderer.cjs"
    },
    "./web-component": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/kong-spec-renderer.web-component.es.js",
      "require": "./dist/kong-spec-renderer.web-component.cjs"
    },
    "./dist/style.css": "./dist/spec-renderer.css",
    "./package.json": "./package.json",
    "./dist/*": "./dist/*"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "dev": "cross-env USE_SANDBOX=true vite",
    "build": "pnpm run typecheck && pnpm run build:package && pnpm run build:webcomponent && pnpm run build:types && pnpm run build:aliases",
    "build:package": "vite build -m production",
    "build:webcomponent": "cross-env VITE_AS_WEB_COMPONENT='true' vite build -m production",
    "build:types": "vue-tsc -p './tsconfig.build.json' --emitDeclarationOnly",
    "build:aliases": "tsc-alias -p './tsconfig.build.json'",
    "build:analyzer": "BUILD_VISUALIZER='true' vite build -m production",
    "build:sandbox": "cross-env USE_SANDBOX=true vite build -m production",
    "preview": "pnpm run build:sandbox && cross-env USE_SANDBOX=true vite preview",
    "typecheck": "vue-tsc -p './tsconfig.build.json' --noEmit",
    "stylelint": "stylelint --allow-empty-input './src/**/*.{css,scss,vue}'",
    "stylelint:fix": "stylelint --allow-empty-input './src/**/*.{css,scss,sass,vue}' --fix",
    "lint": "eslint",
    "lint:fix": "eslint --fix",
    "test": "cross-env FORCE_COLOR=1 vitest run",
    "test:open": "cross-env FORCE_COLOR=1 vitest --ui",
    "semantic-release": "semantic-release",
    "commit": "cz"
  },
  "peerDependencies": {
    "vue": ">= 3.3.13 < 4"
  },
  "dependencies": {
    "@apidevtools/json-schema-ref-parser": "14.0.3",
    "@asyncapi/avro-schema-parser": "^3.0.24",
    "@asyncapi/openapi-schema-parser": "^3.0.24",
    "@asyncapi/parser": "^3.6.0",
    "@floating-ui/vue": "^1.1.11",
    "@kong/icons": "^1.50.0",
    "@stoplight/http-spec": "^7.1.0",
    "@stoplight/json": "^3.21.7",
    "@stoplight/types": "^14.1.1",
    "@stoplight/yaml": "^4.3.0",
    "@vueuse/core": "^14.2.1",
    "allof-merge": "^0.6.8",
    "flatted": "^3.3.4",
    "form-urlencoded": "^6.1.6",
    "httpsnippet": "^3.0.10",
    "lodash-es": "^4.18.1",
    "markdown-it": "^14.1.1",
    "sanitize-html": "^2.17.3",
    "shiki": "^3.23.0"
  },
  "resolutions": {
    "openapi3-ts": "4.5.0"
  },
  "devDependencies": {
    "@babel/types": "^7.29.0",
    "@commitlint/cli": "^19.8.1",
    "@commitlint/config-conventional": "^19.8.1",
    "@digitalroute/cz-conventional-changelog-for-jira": "^8.0.1",
    "@evilmartians/lefthook": "^2.1.4",
    "@kong/design-tokens": "^1.20.1",
    "@kong/eslint-config-kong-ui": "1.6.2",
    "@semantic-release/changelog": "^6.0.3",
    "@semantic-release/git": "^10.0.1",
    "@stylistic/stylelint-plugin": "^5.1.0",
    "@types/jsdom": "^28.0.1",
    "@types/json-schema": "^7.0.15",
    "@types/markdown-it": "^14.1.2",
    "@types/node": "^24.12.2",
    "@types/sanitize-html": "^2.16.1",
    "@vitejs/plugin-vue": "^6.0.5",
    "@vitest/ui": "^3.2.4",
    "@vue/test-utils": "^2.4.6",
    "@vue/tsconfig": "^0.9.1",
    "autoprefixer": "^10.5.0",
    "c8": "^10.1.3",
    "commitizen": "^4.3.1",
    "cross-env": "^10.1.0",
    "cz-conventional-changelog": "^3.3.0",
    "eslint": "^9.39.4",
    "jsdom": "^27.4.0",
    "openapi3-ts": "4.5.0",
    "postcss": "^8.5.8",
    "postcss-html": "^1.8.1",
    "rimraf": "^6.1.3",
    "rollup-plugin-visualizer": "^6.0.11",
    "sass": "^1.99.0",
    "sass-embedded": "^1.99.0",
    "semantic-release": "^25.0.3",
    "stylelint": "^17.5.0",
    "stylelint-config-html": "^1.1.0",
    "stylelint-config-recommended-scss": "^17.0.0",
    "stylelint-config-recommended-vue": "^1.6.1",
    "stylelint-order": "^8.1.1",
    "ts-node": "^10.9.2",
    "tsc-alias": "^1.8.16",
    "tslib": "^2.8.1",
    "typescript": "^5.9.3",
    "vite": "^7.3.2",
    "vite-plugin-node-polyfills": "^0.25.0",
    "vite-plugin-replace": "^0.1.1",
    "vite-plugin-vue-devtools": "^8.1.1",
    "vitest": "3.2.4",
    "vue": "^3.5.32",
    "vue-router": "^4.6.4",
    "vue-tsc": "^3.2.6"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@evilmartians/lefthook",
      "@parcel/watcher",
      "esbuild",
      "vue-demi"
    ],
    "overrides": {
      "openapi3-ts": "4.5.0",
      "jsonpath-plus@<10.3.0": ">=10.4.0",
      "elliptic@<=6.6.0": ">=6.6.1",
      "@babel/helpers@<7.26.10": ">=7.29.2",
      "cross-spawn@>=7.0.0 <7.0.5": ">=7.0.6",
      "brace-expansion@>=1.0.0 <=1.1.11": ">=2.0.3",
      "brace-expansion@>=2.0.0 <=2.0.1": ">=2.0.2",
      "pbkdf2@<=3.1.2": ">=3.1.5",
      "sha.js@<=2.4.11": ">=2.4.12",
      "cipher-base@<=1.0.4": ">=1.0.7",
      "tmp@<=0.2.3": ">=0.2.5",
      "form-data@>=4.0.0 <4.0.4": ">=4.0.5",
      "js-yaml@>=4.0.0 <4.1.1": ">=4.1.1",
      "glob@>=10.2.0 <10.5.0": ">=13.0.6",
      "diff@>=4.0.0 <4.0.4": ">=4.0.4",
      "@isaacs/brace-expansion@<=5.0.0": ">=5.0.1",
      "mdast-util-to-hast@>=13.0.0 <13.2.1": ">=13.2.1",
      "qs@>=6.7.0 <=6.14.1": ">=6.15.0",
      "markdown-it@>=13.0.0 <14.1.1": ">=14.1.1",
      "bn.js@>=5.0.0 <5.2.3": ">=5.2.3",
      "bn.js@<4.12.3": ">=5.2.3",
      "rollup@>=4.0.0 <4.59.0": ">=4.60.1",
      "minimatch@<10.2.3": ">=10.2.5",
      "ajv@<6.14.0": "^6.14.0",
      "immutable@>=5.0.0 <5.1.5": ">=5.1.5",
      "flatted@<=3.4.1": ">=3.4.2",
      "undici@<6.24.0": ">=6.25.0",
      "undici@>=7.0.0 <7.24.0": ">=7.25.0",
      "handlebars@>=4.0.0 <4.7.9": ">=4.7.9",
      "picomatch@>=4.0.0 <4.0.4": ">=4.0.4",
      "picomatch@<2.3.2": ">=2.3.2",
      "lodash-es@<=4.17.23": ">=4.18.0",
      "lodash@<=4.17.23": ">=4.18.0",
      "yaml@>=2.0.0 <2.8.3": ">=2.8.3",
      "vite@>=7.0.0 <=7.3.1": ">=7.3.2"
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Kong/spec-renderer.git"
  },
  "homepage": "https://github.com/Kong/spec-renderer",
  "bugs": {
    "url": "https://github.com/Kong/spec-renderer/issues"
  },
  "author": {
    "name": "Kong Inc.",
    "url": "https://konghq.com/"
  },
  "release": {
    "branches": [
      "+([0-9])?(.{+([0-9]),x}).x",
      "main",
      "next",
      "next-major",
      {
        "name": "beta",
        "prerelease": true
      },
      {
        "name": "alpha",
        "prerelease": true
      }
    ],
    "plugins": [
      "@semantic-release/commit-analyzer",
      "@semantic-release/release-notes-generator",
      [
        "@semantic-release/changelog",
        {
          "changelogFile": "CHANGELOG.md"
        }
      ],
      "@semantic-release/npm",
      [
        "@semantic-release/git",
        {
          "assets": [
            "CHANGELOG.md",
            "package.json"
          ]
        }
      ],
      "@semantic-release/github"
    ]
  },
  "engines": {
    "node": ">=18.17.0"
  },
  "volta": {
    "node": "24.14.1",
    "pnpm": "10.33.0"
  },
  "config": {
    "commitizen": {
      "path": "./node_modules/@digitalroute/cz-conventional-changelog-for-jira",
      "skipScope": false,
      "jiraOptional": true,
      "jiraLocation": "post-description",
      "jiraPrepend": "[",
      "jiraAppend": "]"
    }
  }
}
