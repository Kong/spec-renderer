{
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "ES2022",
      "DOM"
    ],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "outDir": "dist/cli",
    "rootDir": "cli",
    "declaration": false,
    "sourceMap": true,
    "noEmit": true,
    "types": [
      "node"
    ]
  },
  "include": [
    "cli/**/*.ts"
  ]
}
