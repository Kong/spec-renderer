{ "openapi": "3.0.3", "info": { "title": "Remote Refs (small)", "version": "1.0.0", "description": "Small, fast-loading spec for testing remote $refs. Its nested schemas pull in schemas from this repo's konnect-api.yaml via a commit-pinned raw GitHub URL.\n" }, "servers": [ { "url": "https://api.example.com/v1" } ], "paths": { "/portals/{portalId}/overview": { "get": { "summary": "Nested object with remote refs at several depths", "operationId": "getPortalOverview", "parameters": [ { "name": "portalId", "in": "path", "required": true, "schema": { "type": "string", "format": "uuid" } } ], "responses": { "200": { "description": "Portal overview", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/PortalOverview" } } } } } } }, "/portals/{portalId}/registrations": { "post": { "summary": "Remote request body, and an array of nested objects holding remote refs", "operationId": "createRegistrations", "parameters": [ { "name": "portalId", "in": "path", "required": true, "schema": { "type": "string", "format": "uuid" } } ], "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "https://raw.githubusercontent.com/Kong/spec-renderer/f41835ab0e594767e55ad0668958a3bcbd2c2f3d/sandbox/public/specs/konnect-api.yaml#/components/schemas/Application" } } } }, "responses": { "201": { "description": "Created registrations", "content": { "application/json": { "schema": { "type": "object", "properties": { "data": { "type": "array", "items": { "type": "object", "properties": { "registration": { "$ref": "https://raw.githubusercontent.com/Kong/spec-renderer/f41835ab0e594767e55ad0668958a3bcbd2c2f3d/sandbox/public/specs/konnect-api.yaml#/components/schemas/ApplicationRegistration" }, "teams": { "type": "array", "items": { "$ref": "https://raw.githubusercontent.com/Kong/spec-renderer/f41835ab0e594767e55ad0668958a3bcbd2c2f3d/sandbox/public/specs/konnect-api.yaml#/components/schemas/Team" } } } } } } } } } } } } } }, "components": { "s